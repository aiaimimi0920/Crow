# Compose/deployment paths. runtime.env must be mode 0600 on PC2.
FAPAI_RUNTIME_ENV_FILE=/srv/apps/fapaifang-worker/shared/runtime.env
FAPAI_VNC_PASSWORD_FILE=/srv/apps/fapaifang-worker/shared/vnc-password
FAPAI_DATA_ROOT=/srv/data/fapaifang-worker
FAPAI_HOST_DATA_GID=1000
FAPAI_PC2_BIND_ADDRESS=192.168.15.104
FAPAI_BROWSER_DISPLAY_MODE=auto
FAPAI_BROWSER_HOST_DISPLAY=:0
FAPAI_BROWSER_EXECUTABLE=/usr/bin/google-chrome-stable
FAPAI_BROWSER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36
FAPAI_BROWSER_IDENTITY_FULL_VERSION=152.0.7977.64
FAPAI_SOLVER_OS_INPUT_BACKEND=pyautogui

# Central NAS control plane.
FAPAI_NODE_ID=pc2
FAPAI_CENTRAL_API_BASE_URL=https://192.168.15.200:9520/api
FAPAI_API_BASE_URL=https://192.168.15.200:9520/api
FAPAI_API_CA_FILE=/data/secrets/nas-api-ca.pem
FAPAI_COLLECTION_WORKER_TOKEN_FILE=/data/secrets/collection-worker.token
FAPAI_NAS_AUTH_RECOVERY_TOKEN_FILE=/data/secrets/nas-auth-recovery.token
FAPAI_WORKER_DB_URL=postgresql+psycopg://fapaifang:replace-me@192.168.15.200:55432/fapaifang
FAPAI_DB_URL=postgresql+psycopg://fapaifang:replace-me@192.168.15.200:55432/fapaifang

# Local browser/solver container.
FAPAI_CDP_ENDPOINT=http://pc2-browser-solver:9224
FAPAI_DETAIL_CDP_ENDPOINT=http://pc2-browser-solver:9224
FAPAI_REPORT_CDP_ENDPOINT=http://192.168.15.104:9224
FAPAI_CDP_ALLOWED_CLIENT_CIDRS=127.0.0.0/8,::1/128,172.16.0.0/12,192.168.15.20/32,192.168.15.200/32
FAPAI_COOKIE_SNAPSHOT=/data/secrets/nodes/pc2/taobao-cookies.json
FAPAI_COOKIE_SNAPSHOT_PREFER=0
FAPAI_LIST_BROWSER_FALLBACK=1
FAPAI_DETAIL_BROWSER_FALLBACK=1
FAPAI_CAPTCHA_SOLVER_ENABLED=1
FAPAI_REAL_TAOBAO_AUTO_SOLVER_ENABLED=1
FAPAI_SOLVER_MANUAL_FALLBACK_ENABLED=0
FAPAI_SOLVER_COOLDOWN_FAIL_THRESHOLD=10
FAPAI_SOLVER_COOLDOWN_SECONDS=180
FAPAI_SLIDER_RETRY_INTERVAL_SECONDS=5
FAPAI_LOCAL_SOLVER_POLL_SECONDS=5
FAPAI_LOCAL_SOLVER_EXECUTION_TIMEOUT_SECONDS=180
FAPAI_LOCAL_SOLVER_TERMINATE_GRACE_SECONDS=5
FAPAI_LOCAL_SOLVER_WATCHDOG_STALE_SECONDS=300
FAPAI_LOCAL_SOLVER_WATCHDOG_STARTUP_GRACE_SECONDS=180
FAPAI_LOCAL_SOLVER_WATCHDOG_POLL_SECONDS=30
FAPAI_NAS_AUTH_RECOVERY_CLIENT_ENABLED=1
FAPAI_NAS_AUTH_RECOVERY_SNAPSHOT_PATH=/app/.codex-temp/bridge-control/pc2-auth-snapshot.json

# Worker concurrency and cooldowns.
FAPAI_SEED_PAGES_PER_RUN=20
FAPAI_SEED_LOOP_INTERVAL_SECONDS=60
FAPAI_SEED_ACTIVE_LOOP_INTERVAL_SECONDS=30
FAPAI_SEED_FAILURE_COOLDOWN_THRESHOLD=10
FAPAI_SEED_FAILURE_COOLDOWN_SECONDS=180
FAPAI_DETAIL_TARGET_SUCCESS=10
FAPAI_DETAIL_MAX_ATTEMPTS=30
FAPAI_DETAIL_ACTIVE_LOOP_INTERVAL_SECONDS=30
FAPAI_DETAIL_FAILURE_COOLDOWN_THRESHOLD=10
FAPAI_DETAIL_FAILURE_COOLDOWN_SECONDS=180

# Analysis gateway. Keep OPENAI_API_KEY only in runtime.env.
OPENAI_BASE_URL=http://192.168.15.20:8317/v1
OPENAI_API_KEY=replace-me
# Use the exact, case-sensitive routes verified through the LAN gateway.
OPENAI_MODEL=DeepSeek-V4-Pro-0813
OPENAI_MODEL_CANDIDATES=DeepSeek-V4-Pro-0813,DeepSeek-V4-Flash-0731,gemini-3.1-flash
OPENAI_TIMEOUT_SECONDS=180
OPENAI_MAX_RETRIES=2
FAPAI_LLM_PREFLIGHT=1
FAPAI_LLM_PREFLIGHT_TIMEOUT_SECONDS=15

# Analysis module B. Keep off until shadow evaluation is explicitly started.
FAPAI_ANALYSIS_MODULE_B_MODE=off
FAPAI_ANALYSIS_MODULE_B_CANDIDATE_MODELS=DeepSeek-V4-Flash,DeepSeek-V4-Pro-0813,gemini-3.1-flash
FAPAI_ANALYSIS_MODULE_B_ARBITER_MODEL=grok-4.6
FAPAI_ANALYSIS_MODULE_B_MAX_PARALLEL=3
FAPAI_ANALYSIS_MODULE_B_CANDIDATE_ATTEMPTS=3
FAPAI_ANALYSIS_MODULE_B_CANDIDATE_RETRY_SECONDS=10
FAPAI_ANALYSIS_MODULE_B_SHADOW_SAMPLE_RATE=0.01
