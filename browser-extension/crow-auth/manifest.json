{
  "manifest_version": 3,
  "name": "Crow 手动认证",
  "version": "0.1.1",
  "description": "由你明确提交指定淘宝页面的认证会话给本机 Crow。",
  "key": "",
  "permissions": ["cookies", "nativeMessaging", "storage"],
  "host_permissions": [
    "https://taobao.com/*", "https://sf.taobao.com/*", "https://sf-item.taobao.com/*",
    "https://susong-item.taobao.com/*", "https://login.taobao.com/*"
  ],
  "action": {"default_title": "Crow 手动认证", "default_popup": "auth.html"}
}
