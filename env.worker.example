# Legacy wire keys are intentional for container env_file/service.environment layering.
# Host CROW_* inputs are supported by the Crow adapter; do not mechanically rename
# this file's keys. See docs/runbooks/crow-compose-compatibility.md.
# Copy to env.worker.local on each collection PC. Do not commit env.worker.local.
FAPAI_NODE_ID=pc1
# Windows Docker Desktop cannot reliably mount NAS SMB paths directly into
# Linux containers. Use a local worker data root, then mirror output/datas/jobs/
# secrets to NAS with scripts/sync-worker-artifacts-to-nas.ps1.
FAPAI_SHARED_DATA_ROOT_HOST=C:\Users\Public\nas_home\AI\FPFData
# If containers cannot reach the NAS LAN IP directly, start:
#   python tools/worker_tcp_forwarder.py --forward 0.0.0.0:15532=192.168.15.200:55432 --forward 0.0.0.0:18081=192.168.15.200:8001
# Remote central APIs must use HTTPS. Install the issuing CA and worker token in
# /data/secrets before starting the worker; loopback HTTP is only for local development.
FAPAI_CENTRAL_API_BASE_URL=https://host.docker.internal:18081/api
FAPAI_API_CA_FILE=/data/secrets/api-ca.pem
FAPAI_COLLECTION_WORKER_TOKEN_FILE=/data/secrets/collection-worker.token
FAPAI_WORKER_DB_URL=postgresql+psycopg://fapaifang:fapaifang@host.docker.internal:15532/fapaifang

# Local browser/CDP endpoint belongs to this worker PC, not the NAS.
FAPAI_CDP_ENDPOINT=http://host.docker.internal:9223
FAPAI_DETAIL_CDP_ENDPOINT=http://host.docker.internal:9223
FAPAI_REPORT_CDP_ENDPOINT=
# Set to 1 when the endpoint is supplied by a PC1 -> PC2 reverse tunnel. The PC2
# watchdog then waits for the upstream browser instead of starting a local one.
FAPAI_CDP_EXTERNAL=0
FAPAI_CAPTCHA_SOLVER_ENABLED=1
# Must also be enabled on the central API before real Taobao challenges delegate.
FAPAI_REAL_TAOBAO_AUTO_SOLVER_ENABLED=0
# Periodic CDP probes are uncorroborated by worker/API failures; hold them for
# 3 minutes after authentication so an old challenge tab is not treated as new.
FAPAI_POST_AUTH_CDP_PROBE_GRACE_SECONDS=180
FAPAI_LIST_BROWSER_FALLBACK=1
FAPAI_SEED_CAPTCHA_SOLVER_ENABLED=1
# Set both browser fallbacks to 0 while a human owns the shared auth tab. HTTP/cookie
# collection can continue without a worker navigating or dragging that tab.
FAPAI_DETAIL_BROWSER_FALLBACK=1
FAPAI_DETAIL_CAPTCHA_SOLVER_ENABLED=1
FAPAI_DETAIL_LOAD_OPEN_BROWSER_PAGES=0
FAPAI_SEED_AUTH_PROBE_INTERVAL_SECONDS=60
FAPAI_COOKIE_SNAPSHOT=/data/secrets/nodes/${FAPAI_NODE_ID}/taobao-cookies.json
FAPAI_COOKIE_SNAPSHOT_PREFER=0

FAPAI_SEED_JOBS_FILE=/data/jobs/seed_jobs_all.json
FAPAI_SEED_PARALLEL_SORTS=1
FAPAI_LIST_CATEGORIES=50025969,200782003
FAPAI_LIST_MAX_PAGES=83

FAPAI_SEED_COLLECTOR_RESTART=unless-stopped
FAPAI_SEED_COLLECTOR_2_RESTART=unless-stopped
FAPAI_SEED_COLLECTOR_3_RESTART=unless-stopped
FAPAI_SEED_COLLECTOR_4_RESTART=unless-stopped
FAPAI_SEED_COLLECTOR_5_RESTART=unless-stopped
FAPAI_SEED_COLLECTOR_6_RESTART=unless-stopped
FAPAI_DETAIL_WORKER_RESTART=unless-stopped
FAPAI_DETAIL_WORKER_2_RESTART=unless-stopped
FAPAI_DETAIL_WORKER_3_RESTART=unless-stopped
FAPAI_DETAIL_ANALYSIS_WORKER_RESTART=unless-stopped
FAPAI_DETAIL_ANALYSIS_WORKER_2_RESTART=unless-stopped
FAPAI_DETAIL_ANALYSIS_WORKER_3_RESTART=unless-stopped

OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=180
OPENAI_MAX_RETRIES=3
