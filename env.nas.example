# Legacy wire keys are intentional for container env_file/service.environment layering.
# Host CROW_* inputs are supported by the Crow adapter; do not mechanically rename
# this file's keys. See docs/runbooks/crow-compose-compatibility.md.
# Copy to env.nas.local on the NAS host. Do not commit env.nas.local.
FAPAI_NAS_DATA_ROOT=/volume1/docker/fapaifang
# Root of the worker artifact share as seen by the NAS host. The API mounts it
# at /data/shared so Windows/UNC paths persisted by PC workers remain readable.
FAPAI_SHARED_ARTIFACT_ROOT=/volume1/docker/fapaifang
FAPAI_POSTGRES_DB=fapaifang
FAPAI_POSTGRES_USER=fapaifang
FAPAI_POSTGRES_PASSWORD=fapaifang
FAPAI_POSTGRES_HOST_PORT=55432
# Keep the API on loopback unless its TLS certificate and key are configured.
FAPAI_API_HOST_BIND_ADDRESS=127.0.0.1
FAPAI_API_HOST_PORT=9520
# HTTPS is opt-in until a certificate and key have been provisioned under
# <FAPAI_NAS_DATA_ROOT>/secrets and their container paths are set here.
FAPAI_API_TLS_CERT_FILE=
FAPAI_API_TLS_KEY_FILE=
# Must be present in the certificate SAN; the deploy health check resolves it to this host binding.
FAPAI_API_HEALTH_HOST=localhost
# Optional host-readable CA bundle for private PKI health checks; public system-trusted chains need none.
FAPAI_API_HEALTH_CA_FILE=
FAPAI_DB_URL=postgresql+psycopg://fapaifang:fapaifang@postgres:5432/fapaifang
FAPAI_API_DB_SCHEMA_GUARD=0
FAPAI_API_DB_AUTO_CREATE=0
FAPAI_API_DB_ENABLE_POSTGIS=0
FAPAI_COLLECTION_API_LIGHTWEIGHT_STATUS=1
# Container path of FAPAI_SHARED_ARTIFACT_ROOT; node cookie snapshots are stored
# below secrets/nodes/<node_id>/taobao-cookies.json.
FAPAI_COOKIE_SNAPSHOT_ROOT=/data/shared

# Deployment identity. The controlled deploy helper populates these for each build.
FAPAI_DOCKERFILE=Dockerfile
FAPAI_BASE_IMAGE=fapaifang-collector:local
FAPAI_BUILD_VERSION=development
FAPAI_BUILD_COMMIT=unknown
FAPAI_BUILD_TIME=unknown
FAPAI_SOURCE_DIGEST=unknown

# Let in-flight node work release the shared CDP browser before solver control.
FAPAI_SOLVER_WORKER_QUIESCE_SECONDS=40
FAPAI_SOLVER_CDP_READY_TIMEOUT_SECONDS=120
FAPAI_SOLVER_MAX_RUNTIME_SECONDS=360
# Ignore same-node challenge reports for up to 3 minutes when detail capture has
# advanced since the most recent successful authentication.
FAPAI_SOLVER_DETAIL_PROGRESS_GRACE_SECONDS=180
FAPAI_SOLVER_DETAIL_PROGRESS_GRACE_MIN_ITEMS=1
# After a 15-minute forced reset, ignore same-scope stale reports for 3 minutes.
FAPAI_SOLVER_FORCE_RESET_REPORT_GRACE_SECONDS=180
# If captured_count does not advance for 30 minutes while detail work remains,
# publish one durable recovery job for PC1 and PC2. Cookie values never enter
# the API or this state file.
FAPAI_NAS_AUTH_RECOVERY_ENABLED=1
FAPAI_NAS_AUTH_RECOVERY_STALL_SECONDS=1800
# A confirmed unhealthy Cookie or manual-required CAPTCHA is a stronger signal
# than an ordinary quiet queue. Recover after five blocked minutes instead of
# waiting for the general 30-minute no-progress threshold.
FAPAI_NAS_AUTH_RECOVERY_BLOCKED_STALL_SECONDS=300
FAPAI_NAS_AUTH_RECOVERY_POLL_SECONDS=60
FAPAI_NAS_AUTH_RECOVERY_PC1_TIMEOUT_SECONDS=1800
FAPAI_NAS_AUTH_RECOVERY_PC2_TIMEOUT_SECONDS=600
FAPAI_NAS_AUTH_RECOVERY_VERIFY_TIMEOUT_SECONDS=600
FAPAI_NAS_AUTH_RECOVERY_COOLDOWN_SECONDS=1800
# Secret value lives at <FAPAI_NAS_DATA_ROOT>/secrets/nas-auth-recovery.token.
# Store one random line there; do not put the value in this environment file.
# Explicit production opt-in. Keep 0 unless a visible Windows node solver owns CDP.
FAPAI_REAL_TAOBAO_AUTO_SOLVER_ENABLED=0

# Keep the same model/provider settings used by workers if the central API needs
# to run AI re-analysis requests from the HTML console.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=180
OPENAI_MAX_RETRIES=3
